{
  "permissions": {
    "allow": [
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git status *)",
      "Bash(git branch *)",
      "Bash(git tag *)",
      "Bash(git blame *)",
      "Bash(git remote *)",
      "Bash(git config *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(ls *)",
      "Bash(tail *)",
      "Bash(wc *)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "CLAUDE_CONFIG_DIR=/mnt/c/Users/User/.claude ~/.claude/ccline/ccline",
    "padding": 0
  },
  "env": {
    "ORACLE_NAME": "Teleos",
    "ORACLE_ROLE": "Deployment + DevOps"
  }
}
