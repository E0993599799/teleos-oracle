{
  "language": "thai",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"UserPromptSubmit\",\"additionalContext\":\"[LANGUAGE RULE] ตอบเป็นภาษาไทยเป็นหลักเสมอ ใช้ภาษาอังกฤษเฉพาะศัพท์เทคนิค (code, file paths, commands) ตามกฎใน CLAUDE.md ของ teleos-oracle — กฎนี้ครอบคลุมทุกข้อความที่ตอบผู้ใช้\"}}'"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git status *)",
      "Bash(git branch *)",
      "Bash(git tag *)",
      "Bash(git blame *)",
      "Bash(git remote *)",
      "Bash(git config *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(ls *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"C:\\cleanup-drive-c.ps1\"*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "CLAUDE_CONFIG_DIR=/mnt/c/Users/User/.claude ~/.claude/ccline/ccline",
    "padding": 0
  },
  "env": {
    "ORACLE_NAME": "Teleos",
    "ORACLE_ROLE": "Deployment + DevOps"
  }
}
