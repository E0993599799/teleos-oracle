{
  "permissions": {
    "allow": [
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git status *)",
      "Bash(git branch *)",
      "Bash(git tag *)",
      "Bash(git blame *)",
      "Bash(git remote *)",
      "Bash(git config *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(ls *)",
      "Bash(tail *)",
      "Bash(wc *)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "ORACLE_NAME=\"Teleos\" ORACLE_ROLE=\"Deployment + DevOps\" bash ~/.claude/statusline",
    "refreshInterval": 5,
    "hideVimModeIndicator": false
  },
  "env": {
    "ORACLE_NAME": "Teleos",
    "ORACLE_ROLE": "Deployment + DevOps"
  }
}
